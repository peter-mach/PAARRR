# OpenAI API key — required for PR scoring.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# GitHub personal access token — optional but recommended.
# Without it: 60 req/hr (public). With it: 5000 req/hr.
# https://github.com/settings/tokens (classic, no scopes needed for public repos)
GITHUB_TOKEN=
